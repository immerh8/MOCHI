{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mochi.invalid/schemas/json/cli-rekey-list.schema.json",
  "title": "mochi rekey --list --json",
  "description": "The head's key envelopes: `mochi rekey --list --json` (D20). Needs no passphrase.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "action",
    "archive",
    "archive_id",
    "envelopes",
    "exit_code"
  ],
  "properties": {
    "schema": {
      "const": "mochi-cli-rekey-list-v1"
    },
    "command": {
      "const": "rekey"
    },
    "action": {
      "const": "list"
    },
    "archive": {
      "type": "string"
    },
    "archive_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/hex32"
        },
        {
          "type": "null"
        }
      ]
    },
    "envelopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "envelope_id",
          "created_at_seq",
          "kdf"
        ],
        "properties": {
          "envelope_id": {
            "$ref": "common.schema.json#/$defs/hex16"
          },
          "created_at_seq": {
            "$ref": "common.schema.json#/$defs/seq"
          },
          "kdf": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "memory_kib",
              "iterations",
              "lanes"
            ],
            "properties": {
              "algorithm": {
                "const": "argon2id"
              },
              "memory_kib": {
                "$ref": "common.schema.json#/$defs/u32"
              },
              "iterations": {
                "$ref": "common.schema.json#/$defs/u32"
              },
              "lanes": {
                "$ref": "common.schema.json#/$defs/u32"
              }
            }
          }
        }
      }
    },
    "exit_code": {
      "const": 0
    }
  }
}
