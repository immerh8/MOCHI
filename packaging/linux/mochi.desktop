[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %f
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
# application/x-mochi comes from bundle.fileAssociations; it is the
# only type MOCHI is meant to open by default. The rest only lists MOCHI under
# "Open with" (plan D6, O10): this file never sets a default, and the system's own
# defaults (mimeapps.list, GNOME's file-roller) stay in charge. The foreign formats
# are read-only and arrive with plan D8; until then the app says "not supported yet".
MimeType={{mime_type}};application/zip;application/x-7z-compressed;application/vnd.rar;application/x-rar-compressed;application/x-tar;application/x-compressed-tar;application/gzip;
